# 企业微信「我的企业」中的企业 ID
WECOM_CORP_ID=ww0000000000000000

# 企业微信自建应用的 AgentId
WECOM_AGENT_ID=1000002

# 企业微信自建应用 Secret，仅允许配置在服务端
WECOM_APP_SECRET=replace-with-wecom-app-secret

# 必须与企业微信后台的授权回调域匹配
WECOM_CALLBACK_URL=https://unionam.com/api/gift/auth/wecom/callback

# 用于反向代理后的登录成功/失败回跳，不要填内部端口
UNIONAM_PUBLIC_ORIGIN=https://unionam.com

# 至少 32 个字符；生产环境建议使用 openssl rand -base64 48 生成
GIFT_SESSION_SECRET=replace-with-a-long-random-production-secret

# Tripo 图生 3D；仅服务端使用，不得添加 NEXT_PUBLIC_ 前缀
TRIPO_3D_BASE_URL=https://openapi.tripo3d.com/v3
TRIPO_3D_API_KEY=replace-with-tripo-api-key
TRIPO_3D_MODEL=v3.1-20260211
TRIPO_3D_FACE_LIMIT=1500000
TRIPO_3D_GEOMETRY_QUALITY=standard

# OpenAI Image API 兼容中转；仅服务端使用
GPT_IMAGE_BASE_URL=https://api.cdn-krill-ai.com/v1
GPT_IMAGE_API_KEY=replace-with-image-relay-api-key
GPT_IMAGE_MODEL=wan2.7-image-pro
GPT_IMAGE_SIZE=1024x1024
GPT_IMAGE_QUALITY=high
